# Nilasa Storefront Environment Configuration Template
# Copy this file to .env (or .env.production on production servers)

# Server Port
PORT=3000

# Backend API Base URL
API_URL=https://nilasabackend.geecera.com/api/v1
NEXT_PUBLIC_API_URL=https://nilasabackend.geecera.com/api/v1

# Storage / Media URL
STORAGE_URL=https://nilasabackend.geecera.com
NEXT_PUBLIC_STORAGE_URL=https://nilasabackend.geecera.com

# Storefront Public URL (used for OpenGraph and metadata)
NEXT_PUBLIC_SITE_URL=http://nilasa.geecera.com

# Google OAuth 2.0 Client ID (configured in Google Cloud Console -> APIs & Services -> Credentials)
# Authorized JavaScript Origins must include: https://nilasa.geecera.com (and http://localhost:3000 for local dev)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=906427410821-deoi9k1prm79nq6rds5s287g3q56sct3.apps.googleusercontent.com
